<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- Kit: mediator (ISender), Result/DomainError, web/problem-details. -->
    <PackageReference Include="WoW2.Sdk.Backend.Beta" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UzbekStudio.Application\UzbekStudio.Application.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <SpaRoot>$(MSBuildProjectDirectory)/../../uzbek-studio.frontend-services/</SpaRoot>
  </PropertyGroup>

  <Target Name="BuildSpa"
          BeforeTargets="PrepareForBuild;ResolveProjectStaticWebAssets"
          Condition="'$(BuildSpa)' != 'false' and '$(DesignTimeBuild)' != 'true' and '$(NoBuild)' != 'true'">
    <Error Condition="!Exists('$(SpaRoot)package.json')"
           Text="SpaRoot must point to the frontend package directory." />
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
    <ItemGroup>
      <Content Remove="@(Content)"
               Condition="$([System.String]::Copy('%(Content.Identity)').Replace('\', '/').StartsWith('wwwroot/'))" />
      <Content Include="wwwroot/**/*"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
