{
  "name": "uzbekstudio-frontend",
  "private": true,
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "version": "0.1.0",
  "type": "module",
  "description": "React UI for UzbekStudio \u2014 calls the .NET API and is served from its host in production.",
  "scripts": {
    "dev": "vite",
    "dev-http": "VITE_HTTPS=false vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build",
    "test": "vitest run tests/studio-state.test.ts",
    "test:e2e": "playwright test",
    "assets:build": "node scripts/author-garments.mjs",
    "lint": "node scripts/check-boundaries.mjs",
    "format:check": "prettier --check src scripts tests *.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@wow-two-beta/ui": "^0.0.108",
    "lucide-react": "^1.48.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.9",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-mkcert": "2.1.0",
    "vitest": "^5.0.2"
  }
}
