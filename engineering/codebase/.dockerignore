# Build context = engineering/codebase/ (parent of ocharo-studio.backend-services + ocharo-studio.frontend-services).

# Build outputs — restored/rebuilt fresh inside the image
**/bin/
**/obj/
**/dist/
**/node_modules/

# Local SQLite stores — don't ship a dev database into an image layer
**/*.db
**/*.db-shm
**/*.db-wal

# Locally-deployed SPA — the spa stage rebuilds it from source
ocharo-studio.backend-services/OcharoStudio.Api/wwwroot/

# IDE / VCS / OS cruft
**/.vs/
**/.idea/
**/.git/
**/*.user
**/.DS_Store

# Local browser verification output
**/test-results/
**/playwright-report/

# Environment-owned configuration and credentials never enter image layers.
**/appsettings.Local.json
**/appsettings.Target.json
**/appsettings.Machine.json
**/.env
**/.env.*
**/*.pfx
**/*.key
